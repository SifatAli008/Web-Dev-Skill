{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/universal-webdev-skills/universal-webdev-skills/main/templates/schemas/tech-debt-register.schema.json",
  "title": "TechDebtRegisterSchema",
  "description": "Schema for tracking architectural compromises, legacy deprecations, and tech debt from 14-maintenance.",
  "type": "object",
  "required": ["timestamp", "items"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "module", "severity", "effort", "remediation_plan"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "module": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "effort": { "type": "string", "enum": ["S", "M", "L", "XL"] },
          "remediation_plan": { "type": "string" },
          "target_milestone": { "type": "string" }
        }
      }
    }
  }
}
