{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/universal-webdev-skills/universal-webdev-skills/main/templates/schemas/bundle-report.schema.json",
  "title": "BundleReportSchema",
  "description": "Schema for frontend bundle budget, code-splitting, and asset delivery verification from 04-frontend.",
  "type": "object",
  "required": [
    "timestamp",
    "tier",
    "entry_bundle_size_kb",
    "total_bundle_size_kb",
    "budget_limit_kb",
    "budget_status",
    "routes",
    "largest_dependencies"
  ],
  "properties": {
    "timestamp": { "type": "string" },
    "tier": { "type": "string", "enum": ["MVP", "PROD", "SCALE"] },
    "entry_bundle_size_kb": { "type": "number", "minimum": 0 },
    "total_bundle_size_kb": { "type": "number", "minimum": 0 },
    "budget_limit_kb": { "type": "number", "default": 150 },
    "budget_status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "rendering_strategy", "js_size_kb"],
        "properties": {
          "route": { "type": "string" },
          "rendering_strategy": { "type": "string", "enum": ["SSG", "SSR", "ISR", "Client SPA"] },
          "js_size_kb": { "type": "number", "minimum": 0 }
        }
      }
    },
    "largest_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["package_name", "size_kb"],
        "properties": {
          "package_name": { "type": "string" },
          "size_kb": { "type": "number" },
          "treeshakeable": { "type": "boolean" }
        }
      }
    }
  }
}
