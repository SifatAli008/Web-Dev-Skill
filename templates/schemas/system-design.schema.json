{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/universal-webdev-skills/universal-webdev-skills/main/templates/schemas/system-design.schema.json",
  "title": "SystemDesignSchema",
  "description": "Schema for high-level system topology, domain boundaries, data models, and API contracts from 02-architecture.",
  "type": "object",
  "required": [
    "system_id",
    "title",
    "tier",
    "topology",
    "monolith_first_assessment",
    "domain_boundaries",
    "primary_datastores",
    "api_protocols"
  ],
  "properties": {
    "system_id": { "type": "string" },
    "title": { "type": "string" },
    "tier": { "type": "string", "enum": ["MVP", "PROD", "SCALE"] },
    "topology": {
      "type": "string",
      "enum": ["Modular Monolith", "Service-Oriented", "Event-Driven", "Edge/Serverless"]
    },
    "monolith_first_assessment": {
      "type": "object",
      "required": ["adheres_to_monolith_first", "justification"],
      "properties": {
        "adheres_to_monolith_first": { "type": "boolean" },
        "justification": { "type": "string" }
      }
    },
    "domain_boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain_name", "responsibilities", "invariants"],
        "properties": {
          "domain_name": { "type": "string" },
          "responsibilities": { "type": "array", "items": { "type": "string" } },
          "invariants": { "type": "array", "items": { "type": "string" } }
        }
      },
      "minItems": 1
    },
    "primary_datastores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["datastore_type", "engine", "purpose"],
        "properties": {
          "datastore_type": { "type": "string", "enum": ["Relational", "Document", "Key-Value", "Search", "Object Storage"] },
          "engine": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "api_protocols": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["REST", "tRPC", "GraphQL", "gRPC", "WebSocket", "Server-Sent Events"]
      }
    }
  }
}

