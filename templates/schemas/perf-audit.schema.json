{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/universal-webdev-skills/universal-webdev-skills/main/templates/schemas/perf-audit.schema.json",
  "title": "PerformanceAuditSchema",
  "description": "Schema for performance engineering audit reports from 10-performance.",
  "type": "object",
  "required": ["timestamp", "url", "core_web_vitals", "overall_status"],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "url": { "type": "string" },
    "core_web_vitals": {
      "type": "object",
      "required": ["lcp_seconds", "inp_milliseconds", "cls_score"],
      "properties": {
        "lcp_seconds": { "type": "number" },
        "inp_milliseconds": { "type": "number" },
        "cls_score": { "type": "number" }
      }
    },
    "asset_breakdown": {
      "type": "object",
      "properties": {
        "total_js_bytes_gzip": { "type": "integer" },
        "total_css_bytes_gzip": { "type": "integer" },
        "total_image_bytes": { "type": "integer" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "overall_status": { "type": "string", "enum": ["PASS", "WARN", "FAIL"] }
  }
}
