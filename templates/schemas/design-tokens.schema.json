{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sifatali008.github.io/Web-Dev-Skill/schemas/design-tokens.schema.json",
  "title": "Design Tokens & Taste Specification Schema",
  "description": "Standardized schema for design tokens, Taste Profiles (Minimalist, Industrial-Brutalist, Editorial, Soft-Consumer), type scales, spacing rhythm, surface tiers, and WCAG 2.2 AA accessibility contracts.",
  "type": "object",
  "required": [
    "taste_profile",
    "colors",
    "typography",
    "spacing",
    "radius",
    "accessibility"
  ],
  "properties": {
    "taste_profile": {
      "type": "string",
      "enum": [
        "minimalist",
        "industrial-brutalist",
        "editorial",
        "soft-consumer"
      ],
      "description": "The active aesthetic taste profile governing the interface (eradicating AI slop)."
    },
    "colors": {
      "type": "object",
      "required": ["base_bg", "surface_bg", "card_hover", "fg_text", "border", "accent"],
      "properties": {
        "base_bg": { "type": "string" },
        "surface_bg": { "type": "string" },
        "card_hover": { "type": "string" },
        "fg_text": { "type": "string" },
        "border": { "type": "string" },
        "accent": { "type": "string" },
        "functional": {
          "type": "object",
          "properties": {
            "success": { "type": "string" },
            "warning": { "type": "string" },
            "error": { "type": "string" },
            "info": { "type": "string" }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "required": ["font_family", "scale"],
      "properties": {
        "font_family": {
          "type": "object",
          "required": ["sans"],
          "properties": {
            "sans": { "type": "string" },
            "serif": { "type": "string" },
            "mono": { "type": "string" }
          }
        },
        "scale": {
          "type": "object",
          "required": ["xs", "sm", "base", "lg", "xl", "2xl", "3xl", "4xl", "5xl"],
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spacing": {
      "type": "object",
      "required": ["unit", "scale"],
      "properties": {
        "unit": { "type": "string", "enum": ["4px", "8px"] },
        "scale": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "radius": {
      "type": "object",
      "required": ["sm", "md", "lg"],
      "properties": {
        "sm": { "type": "string" },
        "md": { "type": "string" },
        "lg": { "type": "string" },
        "full": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["contrast_body", "contrast_control", "min_touch_target", "focus_ring"],
      "properties": {
        "contrast_body": { "type": "number", "minimum": 4.5 },
        "contrast_control": { "type": "number", "minimum": 3.0 },
        "min_touch_target": { "type": "string" },
        "focus_ring": { "type": "string" }
      }
    }
  }
}
