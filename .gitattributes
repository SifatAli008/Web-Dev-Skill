# Auto-detect text files and normalize line endings to LF on checkout and commit
* text=auto eol=lf

# Explicit text files
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
